{
  "name": "dry-4-js",
  "version": "0.5.0-alpha.6",
  "description": "Structural duplicate detector for JavaScript/ES6 code",
  "type": "module",
  "main": "src/cli.mjs",
  "bin": {
    "dry4js": "src/bin.mjs"
  },
  "exports": {
    ".": "./src/cli.mjs",
    "./scanner": "./src/scanner.mjs",
    "./parser": "./src/parser.mjs",
    "./normaliser": "./src/normaliser.mjs",
    "./fingerprinter": "./src/fingerprinter.mjs",
    "./comparator": "./src/comparator.mjs",
    "./reporter": "./src/reporter.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:crap": "crap4js --coverage-dir ./coverage src",
    "report": "npm run test:coverage && npm run test:crap",
    "start": "node src/bin.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "duplicate",
    "structural",
    "ast",
    "javascript",
    "es6"
  ],
  "author": "testudoq",
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testudoq/DRY4js.git"
  },
  "homepage": "https://github.com/testudoq/DRY4js#readme",
  "bugs": {
    "url": "https://github.com/testudoq/DRY4js/issues"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "crap4js": "^1.0.1-beta.3",
    "vitest": "^4.1.7"
  }
}
